# Configuration SMTP pour l'envoi d'emails
# IMPORTANT: Ne JAMAIS commiter le fichier .env dans Git!
# Copiez ce fichier en .env et remplissez vos vraies valeurs

# Serveur SMTP
SMTP_HOST=smtp.office365.com
# ou SMTP_HOST=smtp.gmail.com

# Port SMTP (587 pour TLS, 465 pour SSL)
SMTP_PORT=587

# Identifiants SMTP
SMTP_USER=votre-email@exemple.com
SMTP_PASS=votre-mot-de-passe

# Email expéditeur (optionnel)
SMTP_FROM=La Mie du Coin <noreply@lamieducoin.com>

# Configuration Supabase
SUPABASE_URL=https://mtuimnyoimiqhuyidyjv.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_ici

# Environnement (development ou production)
NODE_ENV=development

# Notes:
# - Pour Gmail, utilisez un "Mot de passe d'application" (App Password)
# - Activez la validation en deux étapes sur Google
# - Générez le mot de passe ici: https://myaccount.google.com/apppasswords
# 
# - Pour Office365, utilisez votre email complet comme SMTP_USER
# - Le mot de passe est votre mot de passe Office365 normal
