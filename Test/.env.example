# Configuration Email pour l'envoi via Resend
# IMPORTANT: Ne JAMAIS commiter le fichier .env dans Git!
# Copiez ce fichier en .env et remplissez vos vraies valeurs

# ========================================
# Configuration Resend
# ========================================

# Clé API Resend (commence par "re_")
# Obtenez-la sur https://resend.com/api-keys
RESEND_API_KEY=re_votre_cle_api_ici

# Adresse email expéditrice (doit utiliser votre domaine vérifié dans Resend)
# Format: "Nom <email@votredomaine.com>"
RESEND_FROM_EMAIL=La Mie du Coin <noreply@lamieducoin.ca>

# ========================================
# Configuration Supabase
# ========================================

SUPABASE_URL=https://mtuimnyoimiqhuyidyjv.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_ici

# ========================================
# Environnement
# ========================================

# Environnement (development ou production)
NODE_ENV=development

# ========================================
# Notes:
# ========================================
# 
# Pour Resend:
# 1. Créez un compte sur https://resend.com
# 2. Vérifiez votre domaine (ex: lamieducoin.ca)
# 3. Générez une clé API
# 4. L'adresse FROM doit utiliser votre domaine vérifié
# 5. Plan gratuit: 100 emails/jour, 3000/mois
# 
# Documentation: https://resend.com/docs

